# Copy to .env for local development.

# Postgres connection (SQLAlchemy URL). For Azure Postgres, append ?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/workflow

# Shared-secret API key. Clients send it as the `X-API-Key` header.
# Leave blank to DISABLE auth (local dev only).
API_KEY=

# Execution settings
PYTHON_EXECUTABLE=python
DEFAULT_TIMEOUT_SECONDS=3600
WORK_DIR=/tmp/workflow-runs
MAX_CONCURRENT_JOBS=5

# Scheduler
TIMEZONE=UTC
